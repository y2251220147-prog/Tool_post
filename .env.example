# UCircle AI Content Automation — Environment Variables
# Sao chép file này thành .env và điền các giá trị

# ===== GEMINI AI =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== NGUỒN VIDEO / MẠNG XÃ HỘI =====
# YouTube Data API v3: chỉ tìm metadata video Creative Commons, không tải video.
YOUTUBE_API_KEY=
# Facebook Graph API: Page access token của các Page bạn được phép quản lý.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Khuyên dùng: Dashboard sẽ mở OAuth và tự lấy Page token từ hai thông tin này.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/facebook/oauth/callback

# ===== UCIRCLE API =====
UCIRCLE_API_URL=https://ucircle.vn/api
UCIRCLE_API_TOKEN=your_ucircle_api_token_here
UCIRCLE_USERNAME=your_ucircle_username
UCIRCLE_PASSWORD=your_ucircle_password

# ===== DATABASE =====
# SQLite (mặc định, không cần thay đổi)
DATABASE_URL=sqlite:///data/automation.db

# Supabase (V2 - để trống nếu chưa dùng)
SUPABASE_URL=
SUPABASE_KEY=

# ===== SETTINGS =====
# Chế độ hoạt động: manual_review | semi_auto | full_auto
OPERATION_MODE=manual_review

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ===== PLAYWRIGHT (dự phòng nếu không có API) =====
PLAYWRIGHT_HEADLESS=true
